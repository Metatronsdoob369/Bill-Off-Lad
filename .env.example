# BillOff-Lading Environment Configuration

# GEMINI_API_KEY: Optional for local development.
# When provided, enables server-side Gemini 2.5 Flash multimodal Rate-Con / BOL OCR.
# When omitted, the applet automatically uses the deterministic heuristic fallback parser (zero crashes).
GEMINI_API_KEY=""

# PORT: Server port (defaults to 3000)
PORT=3000

# APP_URL: Optional base URL for self-referential links or deployment callbacks
APP_URL="http://localhost:3000"

# Note: Cloud Firestore configuration is automatically loaded from firebase-applet-config.json.
# If running without Firebase or offline, the client seamlessly falls back to sessionStorage persistence.
